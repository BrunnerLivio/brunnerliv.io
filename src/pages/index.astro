---
import { getCollection, render } from "astro:content";
import { slide } from "astro:transitions";
import Base from "../layouts/Base.astro";
import Sign from "../components/Sign.astro";
import LightSwitch from "../components/LightSwitch.astro";
import Row from "../components/Row.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { getPosts } from "../lib/posts";
import { monthYear } from "../lib/format";

const posts = await Promise.all(
  (await getPosts()).map(async (post) => ({
    post,
    minutes: (await render(post)).remarkPluginFrontmatter.minutes,
  })),
);
const projects = (await getCollection("projects")).toSorted((a, b) => a.data.order - b.data.order);
const talks = (await getCollection("talks")).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const sections = [
  {
    id: "writing",
    label: "WRITING",
    rows: posts.map(({ post, minutes }) => ({
      href: `/articles/${post.id}/`,
      title: post.data.title,
      meta: `${monthYear(post.data.date)} · ${minutes} min`,
    })),
  },
  {
    id: "projects",
    label: "PROJECTS",
    rows: projects.map((p) => ({
      href: p.data.sourceCode,
      title: p.data.name,
      sub: p.data.description,
      meta: `${p.data.languages.join(" · ")} ↗`,
      external: true,
    })),
  },
  {
    id: "talks",
    label: "TALKS",
    rows: talks.map((t) => ({
      href: t.data.youtube,
      title: t.data.title,
      sub: t.data.venue,
      meta: monthYear(t.data.date),
      external: true,
    })),
  },
];
---

<Base>
  <div
    class="room fixed inset-0"
    data-flicker="room"
    style="background: radial-gradient(60vw 70vh at 22% 45%, var(--pink-room) 0%, var(--pink-room-mid) 45%, transparent 70%), radial-gradient(50vw 50vh at 30% 62%, var(--cyan-room) 0%, transparent 65%)"
  ></div>

  <div class="relative flex min-h-screen flex-wrap">
    <aside class="flex flex-1 basis-[460px] flex-col items-center justify-center px-6 py-12 wide:sticky wide:top-0 wide:h-screen">
      <Sign />
      <p class="mt-7 flex flex-wrap justify-center gap-x-3 font-mono text-meta tracking-[0.2em] text-muted">
        <a href="https://www.raisenow.com/" target="_blank" rel="noopener" class="text-muted hover:text-text">
          SOFTWARE ENGINEER AT RAISENOW
        </a>
        <span aria-hidden="true">·</span>
        <a
          href="https://github.com/nestjs/nest"
          target="_blank"
          rel="noopener"
          class="text-muted hover:text-text"
        >
          NESTJS CORE TEAM
        </a>
      </p>
      <div class="mt-14">
        <LightSwitch />
      </div>
    </aside>

    <main
      transition:name="list"
      transition:animate={slide({ duration: "1s" })}
      class="relative flex min-w-0 flex-1 basis-[460px] flex-col gap-[12vh] px-[clamp(24px,6vw,96px)] pt-[14vh] pb-[10vh]"
    >
      {sections.map((sec) => (
        <section id={sec.id} class="flex flex-col gap-7">
          <h2 class="neon-head font-neon text-section font-normal tracking-[0.2em]" data-neon-head="0.25">
            {sec.label}
          </h2>
          <ol class="flex flex-col">
            {sec.rows.map((r) => (
              <Row {...r} />
            ))}
          </ol>
        </section>
      ))}
      <SocialLinks />
    </main>
  </div>
</Base>
