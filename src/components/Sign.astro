---
// The neon sign. Click replays the flicker (wired in Base.astro).
---

<div data-sign title="Flick the switch" class="flex cursor-pointer flex-col items-center select-none">
  <span data-flicker="pink" class="tube-pink font-script text-sign-script leading-[0.9] -rotate-6">
    Livio
  </span>
  <span data-flicker="cyan" class="tube-cyan mt-1.5 font-neon text-sign-block tracking-[0.24em] pl-[0.24em]">
    BRU<span data-stutter>N</span>NER
  </span>
</div>
