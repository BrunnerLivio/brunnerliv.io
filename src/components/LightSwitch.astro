---

<button
  type="button"
  data-lights-toggle
  aria-label="Lights on"
  title="Lights"
  class="switch relative flex h-[76px] w-[46px] cursor-pointer items-center justify-center rounded-plate bg-linear-160 from-plate to-plate-dark"
>
  <span class="screw top-[7px]"></span>
  <span class="screw bottom-[7px]"></span>
  <span class="recess relative flex h-[34px] w-[18px] justify-center rounded-lever bg-recess">
    <span class="lever absolute inset-x-[2px] h-[17px] rounded-[2px] bg-linear-180 from-lever to-lever-dark"></span>
  </span>
</button>

<style>
  .switch {
    box-shadow:
      0 6px 14px rgb(0 0 0 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      inset 0 -2px 3px rgb(0 0 0 / 0.15);
  }
  .screw {
    position: absolute;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--color-screw);
    box-shadow: inset 0 1px 1px rgb(0 0 0 / 0.35);
  }
  .recess {
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.35);
  }
  .lever {
    top: 2px;
    box-shadow:
      0 4px 3px rgb(0 0 0 / 0.35),
      inset 0 1px 0 #fff;
    transition:
      top 0.12s var(--ease-lever),
      box-shadow 0.12s;
  }
  html[data-lights="off"] .lever {
    top: 15px;
    box-shadow:
      0 -4px 3px rgb(0 0 0 / 0.3),
      inset 0 -1px 0 rgb(255 255 255 / 0.6);
  }
</style>
